COMPOSE_PROFILES=public
NEBULA_MODE=public
NEBULA_HOST_BIND=0.0.0.0
NEBULA_PANEL_HOST_BIND=127.0.0.1
NEBULA_ADVERTISE_IP=127.0.0.1
NEBULA_PANEL_ORIGIN=https://{{ nebula_public_ip }}
NEBULA_BUILD_REPORT_SHA256={{ nebula_build_report_sha256 }}
NEBULA_SERVER_SHA256={{ nebula_server_sha256 }}
NEBULA_MANAGED_SHA256={{ nebula_managed_sha256 }}
NEBULA_MAX_PROCESSES={{ nebula_max_processes | default(4) }}
NEBULA_IDLE_TTL={{ nebula_personal_world_idle_seconds | default(60) | int }}
NEBULA_PUBLIC_WORLD_IDLE_SECONDS={{ nebula_public_world_idle_seconds | default(900) | int }}
NEBULA_STARTER_CRYSTALS={{ nebula_starter_crystals | default(0) | int }}
NEBULA_STARTER_NP={{ nebula_starter_np | default(0) | int }}
NEBULA_STARTER_APARTMENTS={{ nebula_starter_apartments | default(['Home', 'CliffApartment', 'LakeApartment']) | join(',') }}
NEBULA_ENROLLMENT_MAX_ACCOUNTS={{ nebula_enrollment_max_accounts | default(1000) | int }}
NEBULA_ENROLLMENT_PER_IP_HOURLY={{ nebula_enrollment_per_ip_hourly | default('') }}
NEBULA_ENROLLMENT_GLOBAL_HOURLY={{ nebula_enrollment_global_hourly | default('') }}
NEBULA_PROTECT_STAFF_ACCOUNTS={{ 1 if nebula_protect_staff_accounts | default(true) | bool else 0 }}
NEBULA_PROTECTED_ACCOUNTS={{ nebula_protected_accounts | default([]) | map('string') | join(',') }}
NEBULA_PIDS_LIMIT={{ 256 + 128 * (nebula_max_processes | default(4) | int) }}
NEBULA_PUBLIC_ENROLLMENT={{ 1 if nebula_public_enrollment | default(false) | bool else 0 }}
NEBULA_TRUST_STEAM_ID={{ 1 if nebula_trust_steam_id | default(false) | bool else 0 }}
