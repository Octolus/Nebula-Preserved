# Copy privately to .env. These are documentation values, not issued credentials.
COMPOSE_PROFILES=private
COMPOSE_FILE=compose.yaml
# Pull-only compose.ghcr.yaml: set your lowercase repository image prefix.
NEBULA_IMAGE_PREFIX=
NEBULA_IMAGE_TAG=latest
# configure-image.sh creates runtime.env with verified image labels and immutable
# NEBULA_SERVER_IMAGE / NEBULA_PANEL_IMAGE digest references, overriding the tag.
NEBULA_MODE=private
NEBULA_HOST_BIND=127.0.0.1
NEBULA_ADVERTISE_IP=127.0.0.1
# Source builds: fill these from the reviewed build. Published images: pass the
# generated runtime.env as the second --env-file; do not source it in a shell.
NEBULA_BUILD_REPORT_SHA256=REPLACE_WITH_REVIEWED_64_HEX
NEBULA_SERVER_SHA256=REPLACE_WITH_REVIEWED_64_HEX
NEBULA_MANAGED_SHA256=REPLACE_WITH_REVIEWED_64_HEX
NEBULA_MAX_PROCESSES=16
NEBULA_IDLE_TTL=60
NEBULA_PIDS_LIMIT=4096
NEBULA_ADMIN_TOKEN_SOURCE=./secrets/admin-token.txt
NEBULA_ADMIN_OPERATORS_SOURCE=./secrets/admin-operators.json
NEBULA_PANEL_SESSION_KEY_SOURCE=./secrets/panel-session-key.txt
NEBULA_PANEL_HOST_BIND=127.0.0.1
NEBULA_PANEL_ORIGIN=http://localhost:4321
# Public mode: MODE and COMPOSE_PROFILES=public, HOST_BIND=0.0.0.0,
# COMPOSE_FILE=compose.yaml:compose.public.yaml (Linux path separator).
# Public backend/scene descriptors still use 127.0.0.1 behind the TLS gateway.
NEBULA_TLS_CERTIFICATE_SOURCE=./secrets/fullchain.pem
NEBULA_TLS_PRIVATE_KEY_SOURCE=./secrets/server-key.pem
