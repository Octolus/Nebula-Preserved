# Copy privately to .env. These are documentation values, not issued credentials.
COMPOSE_PROFILES=private
COMPOSE_FILE=compose.yaml
# Pull-only compose.ghcr.yaml: set your lowercase repository image prefix.
NEBULA_IMAGE_PREFIX=
NEBULA_IMAGE_TAG=latest
# configure-image.sh creates runtime.env with verified image labels and immutable
# NEBULA_SERVER_IMAGE / NEBULA_PANEL_IMAGE digest references, overriding the tag.
NEBULA_MODE=private
NEBULA_HOST_BIND=127.0.0.1
NEBULA_ADVERTISE_IP=127.0.0.1
# Source builds: fill these from the reviewed build. Published images: pass the
# generated runtime.env as the second --env-file; do not source it in a shell.
NEBULA_BUILD_REPORT_SHA256=REPLACE_WITH_REVIEWED_64_HEX
NEBULA_SERVER_SHA256=REPLACE_WITH_REVIEWED_64_HEX
NEBULA_MANAGED_SHA256=REPLACE_WITH_REVIEWED_64_HEX
NEBULA_MAX_PROCESSES=16
# Empty personal worlds (apartments) stop after this many idle seconds.
NEBULA_IDLE_TTL=60
# Shared worlds such as Nexus stay warm longer to avoid ~20 s cold starts. Any
# idle (empty) world can still be evicted when a player needs its process slot.
NEBULA_PUBLIC_WORLD_IDLE_SECONDS=900
# Starter wallet applied exactly once when an account is first created.
NEBULA_STARTER_CRYSTALS=0
NEBULA_STARTER_NP=0
# Apartments every account owns (comma separated, case-exact). Existing
# accounts are backfilled once at startup and nothing is ever removed. Home,
# the client's native default, is always included; empty uses this default.
NEBULA_STARTER_APARTMENTS=Home,CliffApartment,LakeApartment
# Enrollment limits (empty per-IP/global use the policy defaults 8/100, or
# 120/1200 with NEBULA_TRUST_STEAM_ID=1).
NEBULA_ENROLLMENT_MAX_ACCOUNTS=1000
NEBULA_ENROLLMENT_PER_IP_HOURLY=
NEBULA_ENROLLMENT_GLOBAL_HOURLY=
# With trusted Steam IDs, staff/operator-linked and listed accounts (comma
# separated SteamID64) still require their primary credential.
NEBULA_PROTECT_STAFF_ACCOUNTS=1
NEBULA_PROTECTED_ACCOUNTS=
# Populate all validated items using explicitly authored preservation stores and
# prices; existing offers, ownership and balances are retained. 'none' opts out.
NEBULA_CATALOG_POLICY=preservation-catalog-v1
## Optional first-claim registration. This does not verify Steam identity.
NEBULA_PUBLIC_ENROLLMENT=0
# Optional: anyone claiming the same Steam ID can access that player account.
NEBULA_TRUST_STEAM_ID=0
NEBULA_PIDS_LIMIT=4096
NEBULA_ADMIN_TOKEN_SOURCE=./secrets/admin-token.txt
NEBULA_ADMIN_OPERATORS_SOURCE=./secrets/admin-operators.json
NEBULA_PANEL_SESSION_KEY_SOURCE=./secrets/panel-session-key.txt
NEBULA_PANEL_HOST_BIND=127.0.0.1
NEBULA_PANEL_ORIGIN=http://localhost:4321
# Public mode: MODE and COMPOSE_PROFILES=public, HOST_BIND=0.0.0.0,
# COMPOSE_FILE=compose.yaml:compose.public.yaml (Linux path separator).
# Public backend/scene descriptors still use 127.0.0.1 behind the TLS gateway.
NEBULA_TLS_CERTIFICATE_SOURCE=./secrets/fullchain.pem
NEBULA_TLS_PRIVATE_KEY_SOURCE=./secrets/server-key.pem
