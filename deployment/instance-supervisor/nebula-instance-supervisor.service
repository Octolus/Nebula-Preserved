[Unit]
Description=Nebula preservation managed-instance supervisor
After=network-online.target nebula-managed-http.service
Wants=network-online.target
Requires=nebula-managed-http.service

[Service]
Type=simple
User=nebula
Group=nebula
EnvironmentFile=/etc/nebula-preservation/nebula.env
WorkingDirectory=/opt/nebula-preservation
ExecStart=/opt/nebula-preservation/.venv/bin/python /opt/nebula-preservation/tools/instance_supervisor.py --run --state-dir ${NEBULA_STATE_DIR} --binary ${NEBULA_SERVER_ELF} --build-report ${NEBULA_BUILD_REPORT} --build-report-sha256 ${NEBULA_BUILD_REPORT_SHA256} --binary-sha256 ${NEBULA_SERVER_SHA256} --managed-assembly-sha256 ${NEBULA_MANAGED_SHA256} --bind ${NEBULA_GAME_BIND} --advertise-ip ${NEBULA_ADVERTISE_IP} --port-range ${NEBULA_PORT_RANGE} --max-processes ${NEBULA_MAX_PROCESSES} --allowed-scene Nexus --allowed-scene LeafPark --allowed-scene Beach --allowed-scene Cinema --allowed-scene Home --allowed-scene Greenhouse --allowed-scene Waterfall --allowed-scene StarCrawlers --allowed-scene BlueWaveHideout --allowed-scene DressingRoom --allowed-scene CutteridgeEstate --allowed-scene TheMoonlightRoom --allowed-scene LeChalet --allowed-scene LakeApartment --allowed-scene SereneGarden --allowed-scene WoodlandClearing --allowed-scene TheNebulian --allowed-scene SorcerersEyrie1 --allowed-scene ZeroDistrictDen --allowed-scene CampSilverLake --allowed-scene FlyingDevice --allowed-scene Deadquarters --allowed-scene HollyridgeEstate --allowed-scene WinterSnowGlobe --allowed-scene TokyoApartment --allowed-scene NebuHouse --allowed-scene WestValleyApartment --allowed-scene WhisperingHillsMansion --allowed-scene CliffApartment --allowed-scene TheCrypt --allowed-scene ForgottenStation --allowed-scene GreekSummerHouse --allowed-scene MountainHideout --allowed-scene GingerbreadHouse --allowed-scene WindMillFarmHouse --allowed-profile nonmini-semantic-v1 --idle-ttl ${NEBULA_IDLE_TTL}
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/nebula-preservation

[Install]
WantedBy=multi-user.target
