# Copy to /etc/nebula-preservation/instance-supervisor.env and replace every placeholder.
NEBULA_STATE_DIR=/var/lib/nebula-preservation
NEBULA_SERVER_ELF=/opt/nebula-preservation/mirror-server/build-linux/NebulaServer.x86_64
NEBULA_BUILD_REPORT=/opt/nebula-preservation/mirror-server/build-linux-validation.json
NEBULA_BUILD_REPORT_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
NEBULA_SERVER_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
NEBULA_MANAGED_SHA256=REPLACE_WITH_64_LOWERCASE_HEX
NEBULA_BIND=0.0.0.0
NEBULA_ADVERTISE_IP=203.0.113.10
NEBULA_HTTP_PORT=8080
NEBULA_PORT_RANGE=28000-28031
NEBULA_MAX_PROCESSES=16
NEBULA_IDLE_TTL=60
