[Unit]
Description=Nebula preservation authenticated HTTP authority (loopback)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=nebula
Group=nebula
WorkingDirectory=/opt/nebula-preservation
EnvironmentFile=/etc/nebula-preservation/nebula.env
ExecStart=/opt/nebula-preservation/.venv/bin/python /opt/nebula-preservation/backend/server.py --listen --bind ${NEBULA_HTTP_BIND} --advertise-ip ${NEBULA_ADVERTISE_IP} --port ${NEBULA_HTTP_PORT} --state-dir ${NEBULA_STATE_DIR} --core-test-profile nonmini-semantic-v1 --managed-instances --public-access
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=control-group
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/nebula-preservation
RestrictAddressFamilies=AF_INET AF_UNIX
SystemCallFilter=@system-service

[Install]
WantedBy=multi-user.target
