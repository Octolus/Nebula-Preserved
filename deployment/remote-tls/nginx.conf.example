# Review with nginx -t before deliberate installation/start.
limit_req_zone $binary_remote_addr zone=nebula_credentials:10m rate=5r/s;

server {
    listen 443 ssl;
    server_name REPLACE_WITH_CERTIFICATE_DNS_HOSTNAME;
    ssl_certificate /etc/nebula-preservation/tls/fullchain.pem;
    ssl_certificate_key /etc/nebula-preservation/tls/server-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    client_header_buffer_size 16k;
    large_client_header_buffers 4 64k;
    client_max_body_size 1m;

    location = /preservation/health {
        allow 127.0.0.1;
        deny all;
        proxy_pass http://127.0.0.1:8080;
    }

    location / {
        limit_req zone=nebula_credentials burst=40 nodelay;
        if ($http_authorization = "") { return 401; }
        proxy_set_header Authorization $http_authorization;
        proxy_set_header Host $host;
        proxy_buffering off;
        proxy_pass http://127.0.0.1:8080;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
