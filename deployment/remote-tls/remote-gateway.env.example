# Private operator copy goes in /etc/nebula-preservation/remote-gateway.env.
# No account token belongs here. Current Windows provisioner uses port 8443.
NEBULA_GATEWAY_PORT=8443
NEBULA_TLS_CERTIFICATE=/etc/nebula-preservation/tls/fullchain.pem
NEBULA_TLS_PRIVATE_KEY=/etc/nebula-preservation/tls/server-key.pem
NEBULA_STATE_DIR=/var/lib/nebula-preservation
