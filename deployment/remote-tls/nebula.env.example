# Source template only. Replace all build pins before any deliberate start.
NEBULA_STATE_DIR=/var/lib/nebula-preservation
NEBULA_BACKUP_DIR=/var/backups/nebula-preservation
NEBULA_HTTP_BIND=127.0.0.1
NEBULA_HTTP_PORT=8080
NEBULA_GAME_BIND=127.0.0.1
NEBULA_ADVERTISE_IP=127.0.0.1
NEBULA_PORT_RANGE=28000-28031
NEBULA_MAX_PROCESSES=16
NEBULA_IDLE_TTL=60
NEBULA_SERVER_ELF=/opt/nebula-preservation/mirror-server/build-linux/NebulaServer.x86_64
NEBULA_BUILD_REPORT=/opt/nebula-preservation/mirror-server/build-linux-validation.json
NEBULA_BUILD_REPORT_SHA256=REPLACE_WITH_EXACT_BUILD_REPORT_SHA256
NEBULA_SERVER_SHA256=REPLACE_WITH_EXACT_LINUX_EXECUTABLE_SHA256
NEBULA_MANAGED_SHA256=REPLACE_WITH_EXACT_MANAGED_ASSEMBLY_SHA256
