{
  "format_version": 1,
  "scope": "Recovered client wire contracts plus explicit local preservation policy; no runtime, listener or connection test",
  "routes": [
    {
      "route": "CheckOwnGenericReward",
      "request": [
        "guid",
        "ps4_id",
        "asset_id"
      ],
      "response": [
        "unused",
        "unused",
        "unused",
        "already_owned_bool"
      ],
      "policy": "checks the durable claim for the configured GenericReward definition; an unknown/disabled definition fails closed"
    },
    {
      "route": "GenericReward",
      "request": [
        "guid",
        "ps4_id",
        "asset_id"
      ],
      "response": [
        "unused",
        "unused",
        "unused",
        "newly_granted_bool"
      ],
      "policy": "atomically grants one configured validated entitlement once per account and key"
    },
    {
      "route": "RewardClothServlet",
      "request": [
        "guid",
        "ps4_id",
        "reward_int"
      ],
      "response": [
        "unused",
        "unused",
        "newly_granted_bool"
      ],
      "policy": "only the native sender's canonical trigger0 is accepted and it must map to a validated wardrobe entitlement"
    },
    {
      "route": "RewardConsumeServlet",
      "request": [
        "guid",
        "ps4_id",
        "asset_id"
      ],
      "response": [
        "true",
        "guid",
        "ps4_id"
      ],
      "policy": "idempotently claims the configured entitlement; repeat calls acknowledge the already durable result"
    },
    {
      "route": "SKLPromoTriggerServlet",
      "request": [
        "guid",
        "ps4_id",
        "promo_id_int"
      ],
      "response": [
        "true",
        "guid",
        "ps4_id",
        "already_consumed_bool"
      ],
      "policy": "checks the claim paired with the configured SKLPromoServlet definition"
    },
    {
      "route": "SKLPromoServlet",
      "request": [
        "guid",
        "ps4_id",
        "promo_id_int"
      ],
      "response": [
        "true",
        "guid",
        "ps4_id",
        "configured_sprite_id_int"
      ],
      "policy": "promo ID and sprite-pair index must exist in the extracted shipped SKL trigger catalog before an idempotent claim can succeed"
    },
    {
      "route": "checkRewardAvailableServlet",
      "request": [
        "guid",
        "ps4_id",
        "reward_type_enum_name"
      ],
      "response": [
        "true",
        "guid",
        "available_bool"
      ],
      "policy": "availability is an explicit enabled local definition restricted to the compiled 12-name Utils.RewardType enum; this check never grants"
    },
    {
      "route": "CinemaInteractionNPServlet",
      "request": [
        "guid",
        "ps4_id",
        "interaction_type_int_0_or_1"
      ],
      "response": [
        "true",
        "guid",
        "ps4_id",
        "success_bool"
      ],
      "policy": "an enabled local definition durably grants ticket0 or popcorn1 capability without currency or a real purchase"
    },
    {
      "route": "CheckIfSpaceStillExistServlet",
      "request": [
        "guid",
        "ps4_id",
        "instance_id"
      ],
      "response": [
        "true",
        "exists_bool"
      ],
      "policy": "true only for the same session/platform allocation and a fresh, unique, loopback, protocol-complete descriptor matching both instance_id and psidglobal"
    }
  ],
  "grant_kinds": {
    "wardrobe": "Catalog.resolve plus Store.grant",
    "companions_or_locomotions": "ResourceCatalog.resolve plus ResourceEntitlements.grant",
    "housing": "HousingStore canonical catalog plus grant_item",
    "coffee_or_oktoberfest": "explicit positive units/uses through Consumables.grant",
    "cinema": "durable local capability only; interaction types0/1"
  },
  "durability": {
    "definitions_table": "local_reward_definitions primary key(route,trigger_key)",
    "claims_table": "local_reward_claims primary key(ps4_id,route,trigger_key)",
    "cinema_table": "cinema_capabilities primary key(ps4_id,interaction_type)",
    "unknown_definition": "HTTP404 ProtocolError; never a fabricated success",
    "repeat_claim": "no duplicate entitlement mutation",
    "atomicity": "BEGIN IMMEDIATE groups entitlement mutation and claim marker; injected post-grant failure rolls both back"
  },
