      "ps4_id",
      "kind",
      "table_id",
      "use_count",
      "reward_index",
      "issued_at",
      "expires_at"
    ],
    "claim": "validate exact schema and identity, then exclusive same-volume move",
    "trust_boundary": "trusted server-local filesystem; not a signed bearer token"
