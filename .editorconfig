root = true

[*]
charset = utf-8
insert_final_newline = true
trim_trailing_whitespace = true

[*.{py,rs,cs,cpp,h,hpp,inc}]
indent_style = space
indent_size = 4

[*.{json,yml,yaml,toml,js,mjs,cjs,jsx,ts,tsx,astro,css,html}]
indent_style = space
indent_size = 2

[*.{sh,yml,yaml,service,timer}]
end_of_line = lf

[*.md]
trim_trailing_whitespace = false
