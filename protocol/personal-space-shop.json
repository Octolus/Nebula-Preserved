{
  "format_version": 1,
  "scope": "Shop identities of personal spaces (apartments) in the shipped client, mapped to their navigator names.",
  "sources": {
    "resources": "resources.assets ResourceManager keys personalspaces/<id>/<id>thumbnail and personalspaces/<id>/screenshotN (31 IDs); exact ID case from the Texture2D names",
    "identification": "Each ID's shipped thumbnail and screenshots were matched to the asset names in the shipped s/<scene> bundle, to readable text in the images, or to the shipped shops/bluewavehideout banner. This is an inference from shipped assets: the client carries no ID-to-name table (the retired server supplied it through GetPurchases personalspaces/personalspacesName)."
  },
  "native_contract": {
    "shop_gender_id": 4,
    "gender_tab": "Spaces",
    "type_id": "PERSON",
    "list_request": "EntryGender.OnClick 0x4a86e0 (switch case 4) -> ShopNETGcloud.Send_GetItemAssetsData 0x411490: GetItemAssetsDataServlet guid#ps4#shopID#4#PERSON",
    "list_receiver": "ShopNETGcloud.Get_GetItemAssetsData 0x40c420: count then ItemData (id,name,imagePath,crystals,np,isBundle,gender,tablename); price <= 0 shows Free (EntryItem.Set 0x4aa380)",
    "thumbnail": "EntryBase.setThumbnail 0x4a7f90: an imagePath containing PersonalSpaces/ is loaded with Resources.Load<Sprite> after \\ -> / and dropping the 4-character extension",
    "screenshots": "EntryItem.OnClick 0x4a9790 -> WardrobeWindow.ShowScrollPersonalSpacesScreenShots 0x4b8030: Resources.Load<Sprite>(PersonalSpaces\\<ItemData.id>\\screenshot<i>) until one is missing",
    "try_on": "EntryItem.OnClick runs the 3D try-on (SetShopBase.Init 0x468390) only when ItemData.gender equals the avatar gender; apartments send a non-avatar gender so the screenshot carousel is shown instead",
    "owned_check": "ShopManager.OnItemSelected 0x4ad160 -> NPShopIsItemPurchased; True -> WardrobeWindow.setBtnsAsPurchased 0x4b90a0",
    "buy": "NPShopBuyItemServlet; Get_NPShopBuyItem 0x40f230 on OK plays the purchase effect, marks the buttons purchased, refreshes ShopInfoPlayer and re-runs HTTPGetPurchases (Process 0x6350d0)",
    "gift": "WardrobeWindow.OnClickGift 0x4b7700 has no category gate; NPShopGiftItemServlet applies to apartments like any item",
    "navigator": "NavigatorSelector.SetPersonalSpaces 0x47d5b0 enables an apartment whose name equals a GetPurchases personalspacesName entry (Persistency.TypePurchase personalspaces = 9); Home is always enabled"
  },
