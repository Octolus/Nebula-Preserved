# Server-side inputs for the remote transport worker's Linux gateway.
# This file contains no account credential. Keep it root-readable only.
NEBULA_PUBLIC_HOST=nebula.example.org
NEBULA_GATEWAY_PORT=8443
NEBULA_TLS_CERTIFICATE=/etc/nebula-preservation/tls/fullchain.pem
NEBULA_TLS_PRIVATE_KEY=/etc/nebula-preservation/tls/private-key.pem
NEBULA_STATE_DIR=/var/lib/nebula-preservation
